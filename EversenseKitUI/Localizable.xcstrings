    "Your sensor has passed day 365. Contact your health care provider to schedule a replacement." : {
      "comment" : "description for MSPAlarm",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد تجاوز جهاز الاستشعار الخاص بك اليوم 365. اتصل بمقدم الرعاية الصحية الخاص بك لتحديد موعد لاستبداله."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš senzor překročil den 365. Kontaktujte svého poskytovatele zdravotní péče a domluvte si výměnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din sensor har passeret dag 365. Kontakt din sundhedsplejerske for at aftale en udskiftning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Sensor hat den Tag 365 überschritten. Wenden Sie sich an Ihren medizinischen Betreuer, um einen Austausch zu vereinbaren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sensor has passed day 365. Contact your health care provider to schedule a replacement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su sensor ha superado el día 365. Póngase en contacto con su médico para programar su sustitución."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anturisi on ohittanut päivän 365. Ota yhteyttä terveydenhuollon tarjoajaan vaihtoaikataulun laatimiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre capteur a dépassé le jour 365. Contactez votre prestataire de soins de santé pour planifier un remplacement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיישן שלך עבר את היום 365. פנה לרופא המטפל שלך כדי לקבוע החלפה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az érzékelője átlépte a 365. napot. A csere ütemezése érdekében lépjen kapcsolatba egészségügyi szolgáltatójával."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sensore ha superato il 365° giorno. Contattare il proprio medico per programmare la sostituzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センサーが 365 日目を過ぎました。医療機関にご連絡の上、交換の手続きを行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "센서가 365일이 지났습니다. 의료 서비스 제공자에게 문의하여 교체 일정을 잡으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensoren din har passert dag 365. Kontakt helsepersonell for å avtale tid for utskifting."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw sensor heeft dag 365 overschreden. Neem contact op met uw zorgverlener om een vervanging te plannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czujnik przekroczył 365 dzień. Skontaktuj się z lekarzem, aby zaplanować wymianę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu sensor ultrapassou o dia 365. Contacte o seu prestador de cuidados de saúde para agendar uma substituição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senzorul dumneavoastră a depășit ziua 365. Contactați furnizorul de servicii medicale pentru a programa o înlocuire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш датчик прошел 365-й день. Обратитесь к своему медицинскому работнику, чтобы запланировать замену."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš snímač prešiel dňom 365. Kontaktujte svojho poskytovateľa zdravotnej starostlivosti a naplánujte výmenu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš senzor je presegel 365. dan. Obrnite se na svojega zdravstvenega delavca in se dogovorite za zamenjavo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din sensor har passerat dag 365. Kontakta din vårdgivare för att boka tid för byte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensörünüz 365. günü geçmiştir. Değişim planlamak için sağlık uzmanınızla iletişime geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш датчик відпрацював 365 днів. Зверніться до лікаря, щоб запланувати заміну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảm biến của bạn đã qua ngày 365. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn để lên lịch thay thế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的传感器已超过第 365 天。请联系您的医疗服务提供者安排更换。"
