      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد انتهت صلاحية جهاز الإرسال الخاص بك من الضمان ولن يوفر قيم الجلوكوز قريبًا. اتصل بالموزع لطلب جهاز إرسال جديد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš vysílač je po záruce a brzy přestane poskytovat hodnoty glukózy. Kontaktujte svého distributora a objednejte si nový převodník."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garantien på din sender er udløbet, og den vil snart ikke længere levere glukoseværdier. Kontakt din distributør for at bestille en ny sender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Garantie für Ihren Transmitter ist abgelaufen, und er wird bald keine Blutzuckerwerte mehr anzeigen. Wenden Sie sich an Ihren Händler, um einen neuen Transmitter zu bestellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your transmitter is out of warranty and will soon no longer provide glucose values. Contact your distributor to order a new transmitter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su transmisor está fuera de garantía y pronto dejará de proporcionar valores de glucosa. Póngase en contacto con su distribuidor para solicitar un nuevo transmisor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähettimesi takuu on päättynyt, eikä se pian enää anna glukoosiarvoja. Ota yhteys jälleenmyyjään uuden lähettimen tilaamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre émetteur n'est plus sous garantie et ne fournira bientôt plus de valeurs de glucose. Contactez votre distributeur pour commander un nouveau transmetteur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המשדר שלך מחוץ לאחריות ובקרוב לא יספק עוד ערכי גלוקוז. צור קשר עם המפיץ שלך להזמנת משדר חדש."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Ön jeladójának lejárt a garanciája, és hamarosan nem fog többé glükózértékeket szolgáltatni. Forduljon a forgalmazójához, hogy új jeladót rendelhessen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il trasmettitore è fuori garanzia e presto non fornirà più i valori del glucosio. Contattare il proprio distributore per ordinare un nuovo trasmettitore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トランスミッターの保証が切れており、まもなくグルコース値が表示されなくなります。新しいトランスミッタを注文する場合は、販売店にご連絡ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랜스미터의 보증 기간이 만료되어 곧 더 이상 혈당 측정값을 제공하지 않습니다. 새 트랜스미터를 주문하려면 대리점에 문의하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garantien på senderen din er utløpt, og den vil snart ikke lenger levere glukoseverdier. Kontakt distributøren din for å bestille en ny sender."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw zender heeft geen garantie meer en zal binnenkort geen glucosewaarden meer leveren. Neem contact op met uw distributeur om een nieuwe zender te bestellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadajnik nie jest już objęty gwarancją i wkrótce przestanie dostarczać wartości glukozy. Skontaktuj się z dystrybutorem, aby zamówić nowy nadajnik."
          }
