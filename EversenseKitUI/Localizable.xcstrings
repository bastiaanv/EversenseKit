    "The connection between your sensor and transmitter is lost. No glucose data is available until the connection is restored." : {
      "comment" : "description for SensorAwolAlarm",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فُقد الاتصال بين جهاز الاستشعار وجهاز الإرسال. لا تتوفر بيانات الجلوكوز حتى يتم استعادة الاتصال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojení mezi snímačem a vysílačem je ztraceno. Dokud se spojení neobnoví, nejsou k dispozici žádná data o glukóze."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen mellem din sensor og sender er blevet afbrudt. Ingen glukosedata er tilgængelige, før forbindelsen er genoprettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zwischen Ihrem Sensor und dem Transmitter ist unterbrochen. Es sind keine Glukosedaten verfügbar, bis die Verbindung wiederhergestellt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection between your sensor and transmitter is lost. No glucose data is available until the connection is restored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha perdido la conexión entre el sensor y el transmisor. No hay datos de glucosa disponibles hasta que se restablezca la conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anturin ja lähettimen välinen yhteys on katkennut. Glukoositietoja ei ole käytettävissä, ennen kuin yhteys palautetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion entre le capteur et le transmetteur est perdue. Aucune donnée de glucose n'est disponible tant que la connexion n'est pas rétablie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיבור בין החיישן למשדר שלך אבד. אין נתוני גלוקוז זמינים עד לשחזור החיבור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az érzékelő és a jeladó közötti kapcsolat megszakadt. A kapcsolat helyreállításáig nem állnak rendelkezésre glükózadatok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il collegamento tra il sensore e il trasmettitore è stato interrotto. Non sono disponibili dati sul glucosio finché non viene ripristinata la connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センサーとトランスミッター間の接続が失われました。接続が回復するまで、グルコースデータは利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "센서와 트랜스미터 간의 연결이 끊어졌습니다. 연결이 복원될 때까지 혈당 데이터를 사용할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen mellom sensoren og senderen er brutt. Ingen glukosedata er tilgjengelige før forbindelsen er gjenopprettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding tussen uw sensor en zender is verbroken. Er zijn geen glucosegegevens beschikbaar totdat de verbinding is hersteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenie między czujnikiem a nadajnikiem zostało utracone. Dane dotyczące glukozy nie będą dostępne do momentu przywrócenia połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ligação entre o sensor e o transmissor perdeu-se. Não há dados de glicose disponíveis até que a ligação seja restabelecida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiunea dintre senzor și transmițător s-a pierdut. Nu sunt disponibile date despre glicemie până la restabilirea conexiunii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение между вашим датчиком и трансмиттером потеряно. Данные о глюкозе недоступны до тех пор, пока соединение не будет восстановлено."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojenie medzi snímačom a vysielačom sa stratilo. Kým sa spojenie neobnoví, nie sú k dispozícii žiadne údaje o glukóze."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezava med senzorjem in oddajnikom je izgubljena. Dokler se povezava ne obnovi, podatki o glukozi niso na voljo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslutningen mellan din sensor och sändare har brutits. Inga glukosdata är tillgängliga förrän anslutningen har återställts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensörünüz ve vericiniz arasındaki bağlantı kesildi. Bağlantı yeniden sağlanana kadar glikoz verisi kullanılamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зв'язок між датчиком і передавачем втрачено. Дані про рівень глюкози недоступні, доки з'єднання не буде відновлено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối giữa cảm biến và máy phát của bạn bị mất. Không có dữ liệu glucose có sẵn cho đến khi kết nối được khôi phục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "传感器与发射机之间的连接中断。在恢复连接之前，无法获得葡萄糖数据。"
          }
        }
      }
    },
    "The connection between your sensor and transmitter is not stable. Please position your transmitter for better signal strength." : {
      "comment" : "description for SensorConnection",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاتصال بين المستشعر وجهاز الإرسال غير مستقر. يرجى وضع جهاز الإرسال الخاص بك للحصول على قوة إشارة أفضل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojení mezi senzorem a vysílačem není stabilní. Umístěte vysílač tak, abyste dosáhli lepší síly signálu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen mellem din sensor og sender er ikke stabil. Placer venligst din sender, så signalet bliver stærkere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zwischen Ihrem Sensor und dem Sender ist nicht stabil. Bitte positionieren Sie Ihren Sender für eine bessere Signalstärke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection between your sensor and transmitter is not stable. Please position your transmitter for better signal strength."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión entre el sensor y el transmisor no es estable. Coloque el transmisor en una posición que mejore la intensidad de la señal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anturin ja lähettimen välinen yhteys ei ole vakaa. Aseta lähetin paremman signaalin voimakkuuden saavuttamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion entre votre capteur et votre émetteur n'est pas stable. Veuillez positionner votre émetteur pour améliorer la force du signal."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיבור בין החיישן למשדר שלך אינו יציב. אנא מקם את המשדר שלך לעוצמת אות טובה יותר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az érzékelő és a jeladó közötti kapcsolat nem stabil. Kérjük, helyezze el az adót a jobb jelerősség érdekében."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il collegamento tra il sensore e il trasmettitore non è stabile. Posizionare il trasmettitore per migliorare la potenza del segnale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センサーと送信機の接続が不安定です。送信機の位置を調整してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "센서와 송신기 사이의 연결이 불안정합니다. 더 나은 신호 강도를 위해 송신기의 위치를 조정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen mellom sensoren og senderen er ikke stabil. Vennligst plasser senderen slik at signalstyrken blir bedre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding tussen uw sensor en zender is niet stabiel. Plaats uw zender voor een betere signaalsterkte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenie między czujnikiem a nadajnikiem nie jest stabilne. Ustaw nadajnik w pozycji zapewniającej lepszą siłę sygnału."
