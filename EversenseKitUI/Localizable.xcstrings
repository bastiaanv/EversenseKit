    "Your calibration is due. Please perform a fingerstick blood glucose meter calibration now." : {
      "comment" : "description for CalibrationRequiredAlarm",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حان موعد المعايرة. يرجى إجراء معايرة مقياس جلوكوز الدم بعصا الإصبع الآن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše kalibrace je splatná. Proveďte prosím kalibraci glukometru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er tid til din kalibrering. Udfør en kalibrering af blodsukkermåleren med fingerstik nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Kalibrierung ist fällig. Bitte führen Sie jetzt eine Kalibrierung des Blutzuckermessgeräts mit dem Finger durch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your calibration is due. Please perform a fingerstick blood glucose meter calibration now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su calibración ha vencido. Realice ahora una calibración del medidor de glucosa en sangre con varilla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrointisi on ajankohtainen. Suorita sormenpääverensokerimittarin kalibrointi nyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre étalonnage doit être effectué. Veuillez procéder maintenant à l'étalonnage du lecteur de glycémie par piqûre au doigt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La calibrazione è in scadenza. Eseguire ora la calibrazione del glucometro da dito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "校正の期限です。今すぐ指血糖測定器の校正を行ってください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er tid for kalibrering. Vennligst utfør en kalibrering av blodsukkermåleren med fingerstikk nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw kalibratie is bijna klaar. Voer nu een kalibratie van de bloedglucosemeter uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbliża się termin kalibracji. Przeprowadź teraz kalibrację glukometru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua calibração está a terminar. Efectue agora uma calibração do medidor de glicemia por picada no dedo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibrarea este scadentă. Vă rugăm să efectuați acum o calibrare cu prelevare de sânge prin puncție în deget cu intermediul glucometrului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок калибровки истек. Пожалуйста, проведите калибровку пальцевого глюкометра прямо сейчас."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša kalibrácia je splatná. Kalibráciu glukometra vykonajte teraz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din kalibrering är försenad. Vänligen utför en kalibrering av blodsockermätaren med fingerstick nu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrasyonunuzun zamanı geldi. Lütfen şimdi bir parmak ucu kan şekeri ölçüm cihazı kalibrasyonu gerçekleştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的校准到期。请立即进行指血血糖仪校准。"
          }
        }
      }
    },
    "Your sensor glucose value is too high. Please measure your glucose manually using your blood glucose meter." : {
      "comment" : "description for SeriouslyHighAlarm",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قيمة الجلوكوز في جهاز الاستشعار لديك مرتفعة للغاية. يُرجى قياس الجلوكوز يدوياً باستخدام جهاز قياس الجلوكوز في الدم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnota glukózy ze senzoru je příliš vysoká. Změřte si prosím glykémii ručně pomocí glukometru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din sensors glukoseværdi er for høj. Mål venligst din glukose manuelt med dit blodsukkerapparat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Sensorblutzuckerwert ist zu hoch. Bitte messen Sie Ihren Blutzucker manuell mit Ihrem Blutzuckermessgerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sensor glucose value is too high. Please measure your glucose manually using your blood glucose meter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valor de glucosa de su sensor es demasiado alto. Por favor, mida su glucosa manualmente utilizando su medidor de glucosa en sangre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anturisi glukoosiarvo on liian korkea. Mittaa glukoosisi manuaalisesti verensokerimittarilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valeur du glucose de votre capteur est trop élevée. Veuillez mesurer votre glycémie manuellement à l'aide de votre lecteur de glycémie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il valore del glucosio del sensore è troppo alto. Misurare manualmente il glucosio con il glucometro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センサーのグルコース値が高すぎます。血糖測定器を使用して手動でグルコースを測定してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorens glukoseverdi er for høy. Vennligst mål glukosen manuelt ved hjelp av blodsukkerapparatet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw sensorglucosewaarde is te hoog. Meet uw glucose handmatig met uw bloedsuikermeter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartość glukozy w czujniku jest zbyt wysoka. Zmierz poziom glukozy ręcznie za pomocą glukometru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valor de glicose do sensor é demasiado elevado. Por favor, meça a sua glicose manualmente utilizando o seu medidor de glicemia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valoarea glicemiei din senzorul dumneavoastră este prea mare. Vă rugăm să vă măsurați glicemia manual cu ajutorul glucometrului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше сенсорное значение глюкозы слишком высокое. Пожалуйста, измерьте уровень глюкозы вручную с помощью глюкометра."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnota glukózy na vašom senzore je príliš vysoká. Glukózu si zmerajte manuálne pomocou glukometra."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din sensors glukosvärde är för högt. Mät ditt glukosvärde manuellt med din blodsockermätare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensör glikoz değeriniz çok yüksek. Lütfen kan şekeri ölçüm cihazınızı kullanarak glikozunuzu manuel olarak ölçün."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的传感器葡萄糖值过高。请使用血糖仪手动测量血糖。"
          }
        }
      }
    },
