          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baterija oddajnika je prazna. Če želite nadaljevati prikaz glukoze na senzorju, oddajnik napolnite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
