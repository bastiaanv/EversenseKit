    "Not enough data was collected after your calibration entry. Please enter a fingerstick blood glucose calibration now." : {
      "comment" : "description for CalibrationFailedAlert",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم جمع بيانات كافية بعد إدخال المعايرة. يرجى إدخال معايرة جلوكوز الدم بعصا الإصبع الآن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zadání kalibrace nebylo shromážděno dostatečné množství dat. Zadejte nyní kalibraci glukózy z prstu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der blev ikke indsamlet nok data efter din kalibreringsindtastning. Indtast en fingerstik-blodsukkerkalibrering nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Ihrer Kalibrierungseingabe wurden nicht genügend Daten erfasst. Bitte geben Sie jetzt eine Blutzuckerkalibrierung mit dem Finger ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough data was collected after your calibration entry. Please enter a fingerstick blood glucose calibration now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han recogido suficientes datos después de introducir la calibración. Por favor, introduzca ahora una calibración de glucosa en sangre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrointimerkinnän jälkeen ei kerätty riittävästi tietoja. Syötä nyt sormenpääverensokerin kalibrointi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas eu assez de données collectées après la saisie de votre étalonnage. Veuillez saisir maintenant un étalonnage de la glycémie par bâtonnet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sono stati raccolti dati sufficienti dopo l'inserimento della calibrazione. Inserire ora una calibrazione della glicemia da dito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリブレーション入力後に十分なデータが収集されませんでした。今すぐ指血糖キャリブレーションを入力してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ble ikke samlet inn nok data etter kalibreringsoppføringen. Vennligst legg inn en blodsukkerkalibrering med fingerstikk nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn niet genoeg gegevens verzameld na uw kalibratie-invoer. Voer nu een bloedglucose kalibratie met een vingerprik in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po wprowadzeniu kalibracji nie zebrano wystarczającej ilości danych. Wprowadź teraz kalibrację stężenia glukozy we krwi z opuszka palca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foram recolhidos dados suficientes após a introdução da calibração. Introduza agora uma calibração de glicemia por picada no dedo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu au fost colectate suficiente date după introducerea calibrării dumneavoastră. Vă rugăm să introduceți acum o calibrare a glicemiei din deget."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После ввода данных о калибровке было собрано недостаточно данных. Пожалуйста, введите калибровку глюкозы крови из пальца сейчас."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zadaní kalibrácie sa nezhromaždilo dostatočné množstvo údajov. Zadajte teraz kalibráciu glukózy z prsta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte tillräckligt med data samlades in efter din kalibrering. Ange en kalibrering av blodsocker med fingerstick nu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrasyon girişinizden sonra yeterli veri toplanmadı. Lütfen şimdi bir parmak çubuğu kan şekeri kalibrasyonu girin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您输入校准数据后，没有收集到足够的数据。请立即输入指血标尺血糖校准值。"
          }
        }
      }
    },
