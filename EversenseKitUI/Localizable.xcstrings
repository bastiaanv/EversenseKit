        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jeladó akkumulátora lemerült. Kérjük, töltse fel most a jeladót, hogy az érzékelő glükózszintjének kijelzése folytatódjon."
