    "Make sure your Eversense is in pairing mode. Please read the manual to learn how to do this." : {
      "comment" : "Scanning hint",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من أن جهاز Eversense في وضع الاقتران. يرجى قراءة الدليل لمعرفة كيفية القيام بذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte, zda je zařízení Eversense v režimu párování. Přečtěte si návod k obsluze, kde se dozvíte, jak to provést."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for, at din Eversense er i parringstilstand. Læs manualen for at finde ud af, hvordan du gør det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergewissern Sie sich, dass sich Ihre Eversense im Pairing-Modus befindet. Bitte lesen Sie das Handbuch, um zu erfahren, wie Sie dies tun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure your Eversense is in pairing mode. Please read the manual to learn how to do this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrese de que su Eversense está en modo de emparejamiento. Lea el manual para saber cómo hacerlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmista, että Eversense on pariliitostilassa. Lue käyttöoppaasta, miten tämä tehdään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que votre Eversense est en mode d'appariement. Veuillez lire le manuel pour savoir comment procéder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurarsi che Eversense sia in modalità di accoppiamento. Per sapere come fare, leggere il manuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エバーセンスがペアリングモードになっていることを確認してください。この方法についてはマニュアルをお読みください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroller at Eversense er i sammenkoblingsmodus. Les bruksanvisningen for å finne ut hvordan du gjør dette."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg ervoor dat uw Eversense in de koppelstand staat. Lees de handleiding om te leren hoe dit werkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upewnij się, że urządzenie Eversense jest w trybie parowania. Przeczytaj instrukcję, aby dowiedzieć się, jak to zrobić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique-se de que o Eversense está no modo de emparelhamento. Leia o manual para saber como o fazer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigurați-vă că Eversense este în modul de împerechere. Vă rugăm să citiți manualul pentru a afla cum să faceți acest lucru."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что устройство Eversense находится в режиме сопряжения. Ознакомьтесь с руководством, чтобы узнать, как это сделать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skontrolujte, či je zariadenie Eversense v režime párovania. Prečítajte si príručku, aby ste zistili, ako to urobiť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollera att din Eversense är i parkopplingsläge. Läs bruksanvisningen för att lära dig hur du gör detta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eversense cihazınızın eşleştirme modunda olduğundan emin olun. Bunun nasıl yapılacağını öğrenmek için lütfen kılavuzu okuyun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保 Eversense 处于配对模式。请阅读手册了解如何操作。"
          }
        }
      }
    },
