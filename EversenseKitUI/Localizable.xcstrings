    "Your transmitter's battery is empty. Please recharge transmitter now to resume sensor glucose display." : {
      "comment" : "description for EmptyBatteryAlarm\"",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بطارية جهاز الإرسال فارغة. يرجى إعادة شحن جهاز الإرسال الآن لاستئناف عرض جلوكوز المستشعر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baterie vysílače je vybitá. Chcete-li obnovit zobrazování glukózy na senzoru, dobijte nyní vysílač."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din senders batteri er tomt. Genoplad venligst senderen nu for at genoptage visning af sensorglukose."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Akku Ihres Transmitters ist leer. Bitte laden Sie den Sender jetzt auf, um die Anzeige des Blutzuckerwerts wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your transmitter's battery is empty. Please recharge transmitter now to resume sensor glucose display."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La batería de su transmisor está agotada. Recargue el transmisor ahora para reanudar la visualización de la glucosa del sensor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähettimen paristo on tyhjä. Lataa lähetin nyt, jotta sensorin glukoosinäyttö jatkuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La batterie de votre émetteur est vide. Veuillez recharger l'émetteur maintenant pour reprendre l'affichage du glucose du capteur."
