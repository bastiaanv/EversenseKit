    "Disable this value if you wish to not receive any alerts from your transmitter" : {
      "comment" : "hint vibration mode",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتعطيل هذه القيمة إذا كنت ترغب في عدم تلقي أي تنبيهات من جهاز الإرسال الخاص بك"
