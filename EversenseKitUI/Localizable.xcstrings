      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتشف جهاز الإرسال لديك خطأ. يرجى الاتصال بخدمة عملاء Eversense."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš vysílač zjistil chybu. Kontaktujte prosím zákaznickou podporu společnosti Eversense."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din sender har opdaget en fejl. Kontakt venligst Eversense kundesupport."
