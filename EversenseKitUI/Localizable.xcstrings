    "Enable this value if you wish to receive alerts from your transmitter if you exceed a high glucose" : {
      "comment" : "hint glucose high",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتمكين هذه القيمة إذا كنت ترغب في تلقي تنبيهات من جهاز الإرسال الخاص بك إذا تجاوزت مستوى الجلوكوز المرتفع"
