    "Your transmitter is out of warranty and will no longer provide glucose values. Contact your distributor to order a new transmitter." : {
      "comment" : "description for TransmitterEOL396",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهاز الإرسال الخاص بك خارج الضمان ولن يوفر قيم الجلوكوز بعد الآن. اتصل بالموزع لطلب جهاز إرسال جديد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš vysílač je po záruce a již nebude poskytovat hodnoty glukózy. Kontaktujte svého distributora a objednejte si nový převodník."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garantien på din sender er udløbet, og den leverer ikke længere glukoseværdier. Kontakt din distributør for at bestille en ny sender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Garantie für Ihren Transmitter ist abgelaufen, sodass er keine Glukosewerte mehr anzeigt. Wenden Sie sich an Ihren Händler, um einen neuen Transmitter zu bestellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your transmitter is out of warranty and will no longer provide glucose values. Contact your distributor to order a new transmitter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su transmisor está fuera de garantía y ya no proporcionará valores de glucosa. Póngase en contacto con su distribuidor para solicitar un nuevo transmisor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähettimesi takuu on päättynyt, eikä se enää anna glukoosiarvoja. Ota yhteys jälleenmyyjään uuden lähettimen tilaamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre transmetteur n'est plus sous garantie et ne fournit plus de valeurs de glucose. Contactez votre distributeur pour commander un nouveau transmetteur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המשדר שלך מחוץ לאחריות ולא יספק עוד ערכי גלוקוז. צור קשר עם המפיץ שלך להזמנת משדר חדש."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Ön jeladójának lejárt a garanciája, és már nem szolgáltat glükózértékeket. Forduljon a forgalmazójához, hogy új jeladót rendeljen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il trasmettitore è fuori garanzia e non fornisce più i valori del glucosio. Contattare il proprio distributore per ordinare un nuovo trasmettitore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トランスミッターの保証が切れており、グルコース値が表示されなくなりました。新しいトランスミッタを注文する場合は、販売店にご連絡ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랜스미터의 보증 기간이 만료되어 더 이상 혈당 측정값을 제공하지 않습니다. 새 트랜스미터를 주문하려면 판매업체에 문의하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garantien på senderen er utløpt, og den vil ikke lenger levere glukoseverdier. Kontakt distributøren din for å bestille en ny sender."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw zender heeft geen garantie meer en geeft geen glucosewaarden meer. Neem contact op met uw distributeur om een nieuwe zender te bestellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przetwornik nie jest już objęty gwarancją i nie będzie dostarczał wartości glukozy. Skontaktuj się z dystrybutorem, aby zamówić nowy nadajnik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
