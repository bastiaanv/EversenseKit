    "If your Eversense 365 is already active, please make sure to use the same account" : {
      "comment" : "login footer same account",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان Eversense 365 الخاص بك نشطاً بالفعل، يُرجى التأكد من استخدام الحساب نفسه"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je váš účet Eversense 365 již aktivní, ujistěte se, že používáte stejný účet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis din Eversense 365 allerede er aktiv, skal du sørge for at bruge den samme konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Ihr Eversense 365 bereits aktiv ist, stellen Sie bitte sicher, dass Sie das gleiche Konto verwenden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your Eversense 365 is already active, please make sure to use the same account"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si su Eversense 365 ya está activo, asegúrese de utilizar la misma cuenta"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos Eversense 365 on jo aktiivinen, varmista, että käytät samaa tiliä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si votre Eversense 365 est déjà actif, assurez-vous d'utiliser le même compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם Eversense 365 שלך כבר פעיל, הקפד להשתמש באותו חשבון"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha az Eversense 365 már aktív, kérjük, győződjön meg róla, hogy ugyanazt a fiókot használja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il vostro Eversense 365 è già attivo, assicuratevi di utilizzare lo stesso account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eversense 365がすでに有効な場合は、同じアカウントを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eversense 365가 이미 활성화되어 있는 경우 동일한 계정을 사용해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis Eversense 365 allerede er aktiv, må du sørge for å bruke den samme kontoen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als uw Eversense 365 al actief is, zorg er dan voor dat u hetzelfde account gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli usługa Eversense 365 jest już aktywna, należy użyć tego samego konta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o seu Eversense 365 já estiver ativo, certifique-se de que utiliza a mesma conta"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă Eversense 365 este deja activ, asigurați-vă că utilizați același cont"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ваш Eversense 365 уже активен, убедитесь, что вы используете ту же учетную запись."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je váš účet Eversense 365 už aktívny, uistite sa, že používate rovnaké konto"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je vaš Eversense 365 že aktiven, se prepričajte, da uporabljate isti račun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om din Eversense 365 redan är aktiv, se till att du använder samma konto"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eversense 365 hesabınız zaten etkinse, lütfen aynı hesabı kullandığınızdan emin olun"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ваш Eversense 365 вже активний, переконайтеся, що ви використовуєте той самий обліковий запис"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu Eversense 365 của bạn đã hoạt động, vui lòng đảm bảo sử dụng cùng một tài khoản"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您的 Eversense 365 已经激活，请确保使用同一账户"
          }
        }
      }
    },
    "In 4 hours, your calibration will be past due and no glucose will be displayed. Please enter a fingerstick blood glucose calibration now." : {
      "comment" : "description for CalibrationNowAlarm",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد 4 ساعات، سيتجاوز موعد المعايرة ولن يتم عرض أي جلوكوز. يُرجى إدخال معايرة الجلوكوز في الدم بعصا الإصبع الآن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za 4 hodiny bude kalibrace po termínu a glukóza se nezobrazí. Zadejte nyní kalibraci glukózy z prstu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om 4 timer vil din kalibrering være forældet, og der vil ikke blive vist noget blodsukker. Indtast venligst en blodsukkerkalibrering med fingerstik nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In 4 Stunden ist Ihre Kalibrierung überfällig und es wird kein Blutzucker angezeigt. Bitte geben Sie jetzt eine Blutzuckerkalibrierung mit dem Finger ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In 4 hours, your calibration will be past due and no glucose will be displayed. Please enter a fingerstick blood glucose calibration now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En 4 horas, su calibración estará vencida y no se mostrará ninguna glucosa. Por favor, introduzca ahora una calibración de glucosa en sangre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrointi on 4 tunnin kuluttua myöhässä, eikä glukoosia näytetä. Syötä sormenpääverensokerin kalibrointi nyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans 4 heures, votre étalonnage sera échu et aucun glucose ne sera affiché. Veuillez procéder maintenant à un étalonnage de la glycémie à l'aide d'un bâtonnet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בעוד 4 שעות, הכיול שלך ייגמר ולא יוצג גלוקוז. אנא הזן כיול גלוקוז בדם ממקל האצבע עכשיו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 óra múlva a kalibráció lejárt, és nem jelenik meg a glükóz. Kérjük, most adjon meg egy ujjbegyes vércukor kalibrációt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tra 4 ore, la calibrazione sarà scaduta e non verrà visualizzato alcun glucosio. Immettere ora una calibrazione della glicemia da dito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4時間後、校正は期限切れとなり、グルコースは表示されません。今すぐ指血糖キャリブレーションを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4시간이 지나면 보정 기한이 지나고 포도당이 표시되지 않습니다. 지금 핑거스틱 혈당 보정을 입력하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om 4 timer vil kalibreringen være overskredet, og ingen glukose vil bli vist. Vennligst angi en blodsukkerkalibrering med fingerstikk nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over 4 uur is uw kalibratie verstreken en wordt er geen glucose weergegeven. Voer nu een bloedglucose kalibratie met een vingerprik uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za 4 godziny upłynie termin kalibracji i glukoza nie będzie wyświetlana. Przeprowadź teraz kalibrację stężenia glukozy we krwi z opuszka palca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro de 4 horas, a calibração estará vencida e não será apresentada qualquer glicemia. Introduza agora uma calibração de glicemia por picada no dedo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În 4 ore, calibrarea va fi expirată și nu va fi afișată nicio măsurătoare a glicemiei. Vă rugăm să introduceți acum o calibrare a glicemiei prin prelevare capilară."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через 4 часа калибровка будет просрочена, и глюкоза не будет отображаться. Пожалуйста, проведите калибровку глюкозы крови с помощью пальца сейчас."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za 4 hodiny bude vaša kalibrácia po termíne a nezobrazí sa žiadna glukóza. Zadajte teraz kalibráciu glukózy z prsta."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čez 4 ure bo umerjanje poteklo in glukoza ne bo prikazana. Zdaj vnesite kalibracijo glukoze v krvi s prstnim merilnikom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om 4 timmar kommer din kalibrering att vara förfallen och ingen glukos kommer att visas. Ange en kalibrering av blodglukos med fingerstick nu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 saat içinde kalibrasyonunuzun zamanı geçmiş olacak ve hiçbir glikoz görüntülenmeyecektir. Lütfen şimdi bir parmak çubuğu kan şekeri kalibrasyonu girin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через 4 години ваше калібрування буде прострочено, і рівень глюкози не відображатиметься. Будь ласка, введіть калібрування рівня глюкози в крові зараз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong 4 giờ, hiệu chuẩn của bạn sẽ quá hạn và không có glucose nào được hiển thị. Vui lòng nhập hiệu chuẩn đường huyết bằng ngón tay ngay bây giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 小时后，您的校准时间将过期，届时将不会显示血糖。请立即输入指血标本进行血糖校准。"
          }
        }
      }
    },
    "Increasing the Upload Delay will lower the Internet usage, but gives the Eversense DMS a small delay" : {
      "comment" : "batch size hint",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستؤدي زيادة تأخير التحميل إلى تقليل استخدام الإنترنت، ولكنها تمنح Eversense DMS تأخيرًا بسيطًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvýšení zpoždění nahrávání sníží využití internetu, ale způsobí malé zpoždění systému Eversense DMS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At øge uploadforsinkelsen vil sænke internetforbruget, men giver Eversense DMS en lille forsinkelse"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Erhöhen der Upload-Verzögerung verringert die Internetnutzung, führt aber zu einer kleinen Verzögerung des Eversense DMS"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Increasing the Upload Delay will lower the Internet usage, but gives the Eversense DMS a small delay"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentar el retardo de subida reducirá el uso de Internet, pero dará al Eversense DMS un pequeño retardo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upload Delay -viiveen lisääminen vähentää Internetin käyttöä, mutta antaa Eversense DMS:lle pienen viiveen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'augmentation du délai de chargement réduit l'utilisation de l'Internet, mais entraîne un léger retard pour le système Eversense DMS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדלת עיכוב ההעלאה תפחית את השימוש באינטרנט, אך תעניק ל- Eversense DMS עיכוב קטן"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Feltöltési késleltetés növelése csökkenti az internethasználatot, de az Eversense DMS-nek egy kis késleltetést biztosít."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentando il ritardo di caricamento si riduce l'utilizzo di Internet, ma il DMS Eversense subisce un piccolo ritardo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロード遅延を増やすと、インターネットの使用量は減りますが、エバーセンスDMSにわずかな遅延が生じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업로드 지연을 늘리면 인터넷 사용량이 줄어들지만, 에버센스 DMS에 약간의 지연이 발생합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du øker opplastingsforsinkelsen, reduseres Internett-bruken, men Eversense DMS får en liten forsinkelse"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het verhogen van de uploadvertraging verlaagt het internetgebruik, maar geeft de Eversense DMS een kleine vertraging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwiększenie opóźnienia wysyłania zmniejszy wykorzystanie Internetu, ale spowoduje niewielkie opóźnienie systemu Eversense DMS"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentar o atraso de carregamento reduzirá o uso da Internet, mas dará ao Eversense DMS um pequeno atraso"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creșterea întârzierii la încărcare va reduce utilizarea internetului, dar va oferi Eversense DMS o mică întârziere"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увеличение задержки загрузки снизит использование Интернета, но даст Eversense DMS небольшую задержку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvýšenie oneskorenia nahrávania zníži využitie internetu, ale spôsobí malé oneskorenie systému Eversense DMS"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povečanje zakasnitve nalaganja bo zmanjšalo uporabo interneta, vendar bo sistem Eversense DMS imel majhno zakasnitev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du ökar Upload Delay minskar internetanvändningen, men Eversense DMS får en liten fördröjning"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleme Gecikmesini artırmak İnternet kullanımını azaltır, ancak Eversense DMS'ye küçük bir gecikme sağlar"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збільшення затримки завантаження зменшує використання Інтернету, але дає Eversense DMS невелику затримку"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tăng độ trễ tải lên sẽ làm giảm mức sử dụng Internet, nhưng mang lại cho Eversense DMS một độ trễ nhỏ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "增加上传延迟会降低互联网使用率，但会给 Eversense DMS 带来少量延迟。"
          }
        }
      }
