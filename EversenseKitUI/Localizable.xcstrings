    "Disable this value if you wish to not receive any alerts from your transmitter" : {
      "comment" : "hint vibration mode",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتعطيل هذه القيمة إذا كنت ترغب في عدم تلقي أي تنبيهات من جهاز الإرسال الخاص بك"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuto hodnotu zakažte, pokud nechcete dostávat žádná upozornění z vysílače."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiver denne værdi, hvis du ikke ønsker at modtage nogen advarsler fra din sender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivieren Sie diesen Wert, wenn Sie keine Alarme von Ihrem Sender erhalten möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disable this value if you wish to not receive any alerts from your transmitter"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactive este valor si no desea recibir ninguna alerta de su emisora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista tämä arvo käytöstä, jos et halua vastaanottaa mitään hälytyksiä lähettimestäsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez cette valeur si vous souhaitez ne pas recevoir d'alertes de votre émetteur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השבת ערך זה אם ברצונך לא לקבל התראות מהמשדר שלך"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja ki ezt az értéket, ha nem szeretne riasztásokat kapni a jeladójától."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivare questo valore se si desidera non ricevere avvisi dal trasmettitore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信機からのアラートを受信しない場合は、この値を無効にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "송신기로부터 알림을 받지 않으려면 이 값을 비활성화합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiver denne verdien hvis du ikke ønsker å motta noen varsler fra senderen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel deze waarde uit als u geen waarschuwingen van uw zender wilt ontvangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz tę wartość, jeśli nie chcesz otrzymywać żadnych powiadomień z nadajnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar este valor se não pretender receber quaisquer alertas do seu transmissor"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivați această valoare dacă doriți să nu primiți nicio alertă de la transmițătorul dumneavoastră"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключите это значение, если вы хотите не получать никаких предупреждений от передатчика."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túto hodnotu vypnite, ak nechcete dostávať žiadne upozornenia z vysielača."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To vrednost onemogočite, če ne želite prejemati nobenih opozoril iz oddajnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
