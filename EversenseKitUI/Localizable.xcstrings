    "Enable this value if you wish to receive alerts from your transmitter if you exceed a high glucose" : {
      "comment" : "hint glucose high",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتمكين هذه القيمة إذا كنت ترغب في تلقي تنبيهات من جهاز الإرسال الخاص بك إذا تجاوزت مستوى الجلوكوز المرتفع"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuto hodnotu povolte, pokud si přejete dostávat upozornění z vysílače, pokud překročíte vysokou hladinu glukózy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivér denne værdi, hvis du ønsker at modtage advarsler fra din sender, hvis du overskrider en høj glukosegrænse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie diesen Wert, wenn Sie Warnungen von Ihrem Sender erhalten möchten, wenn Sie einen hohen Blutzuckerwert überschreiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable this value if you wish to receive alerts from your transmitter if you exceed a high glucose"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active este valor si desea recibir alertas de su transmisor si supera un nivel alto de glucosa"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota tämä arvo käyttöön, jos haluat saada lähettimestäsi hälytyksiä, jos ylität korkean glukoosipitoisuuden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez cette valeur si vous souhaitez recevoir des alertes de votre transmetteur en cas de dépassement d'un taux de glucose élevé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivare questo valore se si desidera ricevere avvisi dal trasmettitore se si supera un valore elevato di glucosio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高グルコースを超えた場合にトランスミッターからアラートを受信したい場合は、この値を有効にします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver denne verdien hvis du ønsker å motta varsler fra senderen din hvis du overskrider en høy glukose"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel deze waarde in als u waarschuwingen van uw zender wilt ontvangen wanneer u een hoge glucosewaarde overschrijdt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz tę wartość, jeśli chcesz otrzymywać powiadomienia z nadajnika o przekroczeniu wysokiego poziomu glukozy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
