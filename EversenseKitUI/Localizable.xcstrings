    "Are you sure you want to remove this follower from your Eversense NOW sharing?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من رغبتك في إزالة هذا المتابع من مشاركة Eversense الآن؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jste si jisti, že chcete tohoto následovníka odstranit ze sdílení Eversense NOW?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil fjerne denne følger fra din Eversense NOW-deling?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie diesen Follower aus Ihrer Eversense NOW Freigabe entfernen möchten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
