    "Are you sure you want to stop using Eversense CGM?" : {
      "comment" : "Message for CgmManager deletion action sheet",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من رغبتك في التوقف عن استخدام جهاز قياس نسبة السكر في الدم Eversense؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jste si jisti, že chcete přestat používat CGM Eversense?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil stoppe med at bruge Eversense CGM?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie Eversense CGM nicht mehr verwenden wollen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to stop using Eversense CGM?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás seguro de que quieres dejar de usar Eversense CGM?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletko varma, että haluat lopettaa Eversense CGM:n käytön?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir arrêter d'utiliser Eversense CGM ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È sicuro di voler smettere di usare Eversense CGM?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本当にエバーセンスCGMの使用を中止したいですか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil slutte å bruke Eversense CGM?"
          }
        },
        "nl" : {
