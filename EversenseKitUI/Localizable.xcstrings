    "The system has detected a problem with your transmitter's battery. You can continue to use your system, but please contact Eversense Customer Support for a replacement transmitter." : {
      "comment" : "description for BatteryErrorAlarm",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتشف النظام مشكلة في بطارية جهاز الإرسال الخاص بك. يمكنك الاستمرار في استخدام نظامك، ولكن يرجى الاتصال بدعم عملاء Eversense للحصول على جهاز إرسال بديل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systém zjistil problém s baterií vysílače. Systém můžete nadále používat, ale pro náhradní vysílač se obraťte na zákaznickou podporu společnosti Eversense."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemet har opdaget et problem med din senders batteri. Du kan fortsætte med at bruge systemet, men kontakt venligst Eversense Customer Support for at få en ny sender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das System hat ein Problem mit der Batterie Ihres Senders festgestellt. Sie können Ihr System weiterhin verwenden, aber wenden Sie sich bitte an den Eversense-Kundendienst, um einen Ersatzsender zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The system has detected a problem with your transmitter's battery. You can continue to use your system, but please contact Eversense Customer Support for a replacement transmitter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sistema ha detectado un problema con la batería de su transmisor. Puede seguir utilizando el sistema, pero póngase en contacto con el servicio de atención al cliente de Eversense para obtener un transmisor de repuesto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestelmä on havainnut ongelman lähettimen akussa. Voit jatkaa järjestelmän käyttöä, mutta ota yhteyttä Eversensen asiakastukeen vaihtolähettimen hankkimiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système a détecté un problème avec la batterie de votre émetteur. Vous pouvez continuer à utiliser votre système, mais veuillez contacter le service clientèle d'Eversense pour obtenir un émetteur de remplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sistema ha rilevato un problema con la batteria del trasmettitore. È possibile continuare a utilizzare il sistema, ma si prega di contattare l'assistenza clienti Eversense per ottenere un trasmettitore sostitutivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムが送信機のバッテリーの問題を検出しました。システムを引き続き使用することはできますが、トランスミッターの交換をご希望の場合はエバーセンスカスタマーサポートまでご連絡ください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemet har oppdaget et problem med batteriet i senderen. Du kan fortsette å bruke systemet, men ta kontakt med Eversense Customer Support for å få en ny sender."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het systeem heeft een probleem met de batterij van uw zender gedetecteerd. U kunt het systeem blijven gebruiken, maar neem contact op met de Eversense Klantenservice voor een vervangende zender."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System wykrył problem z baterią nadajnika. Można nadal korzystać z systemu, ale należy skontaktować się z działem obsługi klienta Eversense w celu wymiany nadajnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sistema detectou um problema com a bateria do seu transmissor. Pode continuar a usar o sistema, mas contacte o Apoio ao Cliente da Eversense para obter um transmissor de substituição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistemul a detectat o problemă cu bateria transmițătorului dumneavoastră. Puteți continua să utilizați sistemul, dar vă rugăm să contactați Asistența Clienți Eversense pentru un transmițător de schimb."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Система обнаружила проблему с батареей вашего передатчика. Вы можете продолжать пользоваться системой, но обратитесь в службу поддержки клиентов Eversense для замены передатчика."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systém zistil problém s batériou vysielača. Systém môžete naďalej používať, ale kontaktujte zákaznícku podporu spoločnosti Eversense, ktorá vám poskytne náhradný vysielač."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemet har upptäckt ett problem med batteriet i din sändare. Du kan fortsätta att använda systemet, men kontakta Eversense kundtjänst för att få en ersättningssändare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem, vericinizin pilinde bir sorun tespit etti. Sisteminizi kullanmaya devam edebilirsiniz, ancak lütfen yedek bir verici için Eversense Müşteri Desteği ile iletişime geçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统检测到发射机电池有问题。您可以继续使用系统，但请联系 Eversense 客户支持中心更换发射机。"
          }
        }
      }
    },
