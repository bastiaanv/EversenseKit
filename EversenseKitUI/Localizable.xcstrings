          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vysílač vás může upozornit, pokud předpokládá, že klesáte pod prahovou hodnotu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
