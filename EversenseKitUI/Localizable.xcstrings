        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activați această valoare dacă doriți să primiți alerte de la transmițătorul dumneavoastră dacă depășiți un nivel ridicat al glicemiei"
          }
        },
        "ru" : {
