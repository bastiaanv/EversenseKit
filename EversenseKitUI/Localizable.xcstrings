    "Use your BG meter to monitor your glucose. Contact Eversense Customer Support if the issue persists." : {
      "comment" : "description for GeneralGlucoseSuspended",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم جهاز قياس مستوى السكر في الدم لمراقبة مستوى الجلوكوز لديك. اتصل بخدمة عملاء Eversense إذا استمرت المشكلة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ke sledování glykémie používejte glukometr. Pokud problém přetrvává, kontaktujte zákaznickou podporu společnosti Eversense."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug din BG-måler til at overvåge din glukose. Kontakt Eversense kundesupport, hvis problemet fortsætter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie Ihr BZ-Messgerät, um Ihren Blutzucker zu überwachen. Wenden Sie sich an den Eversense-Kundendienst, wenn das Problem weiterhin besteht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your BG meter to monitor your glucose. Contact Eversense Customer Support if the issue persists."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice su medidor de glucemia para controlar su glucosa. Póngase en contacto con el servicio de atención al cliente de Eversense si el problema persiste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä glukoosimittaria glukoosin seurantaan. Ota yhteyttä Eversensen asiakastukeen, jos ongelma jatkuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez votre lecteur BG pour surveiller votre glycémie. Contactez le service clientèle d'Eversense si le problème persiste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizzare il glucometro per monitorare il glucosio. Contattare l'assistenza clienti Eversense se il problema persiste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BGメーターを使用してグルコースをモニターしてください。問題が解決しない場合は、Eversenseカスタマーサポートにご連絡ください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk blodsukkermåleren til å overvåke blodsukkeret. Kontakt Eversense kundestøtte hvis problemet vedvarer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik uw BG meter om uw glucose te controleren. Neem contact op met de Eversense Klantenservice als het probleem zich blijft voordoen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do monitorowania poziomu glukozy należy używać glukometru. Jeśli problem nie ustąpi, skontaktuj się z działem obsługi klienta Eversense."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilize o seu medidor de glicemia para monitorizar a sua glicose. Contacte o Apoio ao Cliente Eversense se o problema persistir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosiți glucometrul pentru a vă monitoriza glicemia. Contactează serviciul de asistență pentru clienți Eversense dacă problema persistă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте свой BG-метр для контроля уровня глюкозы. Если проблема сохраняется, обратитесь в службу поддержки клиентов Eversense."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na monitorovanie hladiny glukózy používajte glukomer. Ak problém pretrváva, kontaktujte zákaznícku podporu spoločnosti Eversense."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd din BG-mätare för att övervaka din glukos. Kontakta Eversense kundsupport om problemet kvarstår."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glikozunuzu izlemek için BG ölçüm cihazınızı kullanın. Sorun devam ederse Eversense Müşteri Desteği ile iletişime geçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用血糖仪监测血糖。如果问题仍然存在，请联系 Eversense 客户支持中心。"
          }
        }
      }
    },
