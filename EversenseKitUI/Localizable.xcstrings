    "Your Transmitter is past due for Calibration. Sensor Glucose values will no longer be displayed." : {
      "comment" : "description for CalibrationGracePeriodAlarm",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد فات موعد معايرة جهاز الإرسال الخاص بك. لن يتم عرض قيم جلوكوز المستشعر بعد الآن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrace vašeho vysílače již proběhla. Hodnoty glukózy ze snímače se již nebudou zobrazovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrering af din sender er overskredet. Sensorens glukoseværdier vil ikke længere blive vist."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kalibrierung Ihres Transmitters ist überfällig. Die Sensor-Glukosewerte werden nicht mehr angezeigt."
