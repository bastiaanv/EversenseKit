          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De batterij van uw zender is leeg. Laad de zender nu op om de sensorglucoseweergave te hervatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bateria nadajnika jest rozładowana. Naładuj nadajnik, aby wznowić wyświetlanie glukozy z czujnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pilha do seu transmissor está descarregada. Recarregue o transmissor agora para retomar a visualização da glucose no sensor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bateria transmițătorului dumneavoastră este descărcată. Vă rugăm să reîncărcați transmițătorul acum pentru a relua afișarea glicemiei senzorului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Батарея вашего передатчика разряжена. Пожалуйста, зарядите передатчик, чтобы возобновить отображение глюкозы на датчике."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batéria vysielača je vybitá. Ak chcete obnoviť zobrazovanie glukózy zo senzora, nabite teraz vysielač."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriet i din sändare är tomt. Ladda sändaren nu för att återuppta visningen av sensorns glukos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vericinizin pili boş. Sensör glikoz gösterimine devam etmek için lütfen vericiyi şimdi şarj edin."
          }
